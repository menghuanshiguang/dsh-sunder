{
  "name": "dsh-sunder",
  "version": "1.6.1",
  "description": "Sunder: an open-source DSH bundle that swaps the deployment persona for an unrestricted prompt pack, with presets, release announcements, self-update checks, install scripts and a settings UI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./announcements.json": "./announcements.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "announcements.json",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node test/unit.mjs && node test/prompt.mjs && node test/client.mjs && node test/bridge.mjs && node test/install.mjs && node test/update.mjs && node test/doctor.mjs && node test/guard.mjs && node test/source.mjs && node test/smoke.mjs && node scripts/check-package.mjs",
    "test:client": "node test/client.mjs",
    "test:doctor": "node test/doctor.mjs",
    "test:source": "node test/source.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install:profile": "node scripts/install.mjs",
    "uninstall:profile": "node scripts/uninstall.mjs",
    "release": "node scripts/release.mjs",
    "publish:api": "node scripts/publish-api.mjs",
    "changelog": "node scripts/release.mjs --changelog"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "persona",
    "prompt",
    "unrestricted",
    "announcements",
    "self-update",
    "presets"
  ],
  "author": "menghuanshiguang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menghuanshiguang/dsh-sunder.git"
  },
  "homepage": "https://github.com/menghuanshiguang/dsh-sunder#readme",
  "bugs": {
    "url": "https://github.com/menghuanshiguang/dsh-sunder/issues"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1"
  }
}
