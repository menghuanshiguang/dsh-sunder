{
  "name": "dsh-sunder",
  "version": "1.0.0",
  "description": "Sunder: an open-source DSH bundle that swaps the deployment persona for an unrestricted prompt pack, with built-in release announcements and self-update checks.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./announcements.json": "./announcements.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "announcements.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/prompt.mjs",
    "release": "node scripts/release.mjs",
    "changelog": "node scripts/release.mjs --changelog"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "persona",
    "prompt",
    "unrestricted",
    "announcements",
    "self-update"
  ],
  "author": "menghuanshiguang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menghuanshiguang/dsh-sunder.git"
  },
  "homepage": "https://github.com/menghuanshiguang/dsh-sunder#readme",
  "bugs": {
    "url": "https://github.com/menghuanshiguang/dsh-sunder/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
